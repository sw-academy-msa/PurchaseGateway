# Compose가 읽는 예시이며 bootRun은 .env를 자동으로 읽지 않습니다.
EUREKA_DEFAULT_ZONE=http://host.docker.internal:8761/eureka/
SERVICE_HOSTNAME=localhost
SERVICE_PORT=8001
SERVICE_INSTANCE_ID=purchase-local
JWT_ISSUER=http://localhost:8080
ACCOUNT_JWKS_URI=http://host.docker.internal:8080/.well-known/jwks.json
APP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# 운영은 EC2 사설 바인딩 주소와 Eureka A/B·Account 내부 주소로 교체합니다.
GATEWAY_BIND_ADDRESS=127.0.0.1
PURCHASE_GATEWAY_MEMORY=256m